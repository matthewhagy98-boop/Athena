DATABASE_URL=postgresql+psycopg://evidence_engine:evidence_engine@localhost:5432/evidence_engine
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
EMAIL_SENDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=digest@example.com

# Trending Dashboard kill switch. Defaults to false, so a fresh checkout and the
# Playwright run both start with the dashboard OFF: "/" redirects to /#/search, the
# sidebar omits the entry, and the five dashboard routes answer 404 and are absent from
# /openapi.json. Set to true to enable; takes effect on an API restart, no frontend
# rebuild (the client reads /features at runtime). See docs/dashboard-metrics.md.
DASHBOARD_ENABLED=false
